# Copy to .env.dev / .env.integration / .env.e2e / .env.test and adjust per environment.
# See docker-compose.dev.yml / docker-compose.integration.yml / docker-compose.e2e.yml
# for the matching Postgres container ports.

NODE_ENV=development
PORT=4000

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5532/financy_dev

JWT_SECRET=change-me-to-a-random-32-plus-character-secret
JWT_EXPIRY=7d

GRAPHQL_COMPLEXITY_LIMIT=1000
GRAPHQL_DEPTH_LIMIT=10

LOCALE=pt-br

ALLOWED_ORIGINS=http://localhost:5173
